<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photosLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/photoDetailLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/mb_orange"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/selectedPhotoTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fotos"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/selectedPhotoDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Selecciona una portada para ver su descripción."
            android:textColor="@color/black"
            android:textSize="14sp" />

    </LinearLayout>

    <ListView
        android:id="@+id/photoList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@color/mb_orange"
        android:dividerHeight="1dp" />

</LinearLayout>