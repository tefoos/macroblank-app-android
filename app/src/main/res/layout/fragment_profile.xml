<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/profileScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/profileLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/artistPhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="Foto del artista"
            android:scaleType="centerCrop"
            android:src="@drawable/artist_photo" />

        <TextView
            android:id="@+id/artistName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Macroblank"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistGenre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Vaporwave, downtempo, barber beats"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/bioTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Biografía"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistBio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="Productor anónimo de música electrónica asociado a la segunda ola del vaporwave y al estilo barber beats. Su sonido se construye a partir de samples ralentizados y manipulados, con atmósferas calmadas y nostálgicas. Su identidad sigue siendo un misterio."
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/careerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Trayectoria"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artistCareer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="Surgió en 2022 con álbumes como Flesh and Soul, de estética medieval, y ese mismo año publicó más de diez discos en Bandcamp. Cerró 2022 con ANALOG レアリティ, una edición física limitada a 300 copias en CD y casete."
            android:textColor="@color/black"
            android:textSize="14sp" />

    </LinearLayout>

</ScrollView>